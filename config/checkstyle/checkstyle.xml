<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    .editorconfig [*.java] 설정(IntelliJ 코드 스타일 Export) 기준 규칙.
    - 줄 길이 120자 (max_line_length)
    - 들여쓰기 4칸, 연속 줄 8칸, 탭 미사용 (indent_size, ij_continuation_indent_size, indent_style)
    - 빈 줄에 들여쓰기 공백 금지 (ij_java_keep_indents_on_empty_lines=false)
    - 와일드카드 import 미사용 (ij_java_class/names_count_to_use_import_on_demand=999)
    - import 순서: 그 외 → 빈 줄 → javax·java(빈 줄 없음) → 빈 줄 → static (ij_java_imports_layout)
    - 중괄호는 줄 끝, else/catch/finally/do-while은 } 와 같은 줄 (*_brace_style, *_on_new_line=false)
    - 클래스·메서드·필드 어노테이션은 한 줄에 하나씩 (*_annotation_wrap=split_into_lines)
    - 단항 연산자·:: 앞뒤 공백 없음, 향상된 for 의 : 앞뒤 공백 (ij_java_space_*)
    - 필드·메서드·클래스 사이 빈 줄 1줄 (ij_java_blank_lines_around_*=1)
    - 선언부 연속 빈 줄 금지 (ij_java_keep_blank_lines_in_declarations=0)
    - 코드 안 연속 빈 줄 최대 2줄 (ij_java_keep_blank_lines_in_code=2)
    - 삼항 연산자 ?, : 는 줄 앞 (ij_java_ternary_operation_signs_on_next_line=true)
    - 이항 연산자는 줄 끝 (ij_java_binary_operation_sign_on_next_line=false)
    - 대입 연산자 = 는 줄 끝 (ij_java_place_assignment_sign_on_next_line=false)
    - 메서드 체이닝 . 은 줄 앞 (ij_java_method_call_chain_wrap)
    체크스타일로 강제할 수 없는 항목: 줄바꿈 시점(on_every_item, split_into_lines, wrap_first_method_in_call_chain),
    클래스 헤더 뒤 빈 줄 0줄, Javadoc 서식
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- 탭 대신 공백 -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- 줄 길이 -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^(package|import) .*$"/>
    </module>

    <!-- 빈 줄에 들여쓰기 공백 금지 -->
    <module name="RegexpSingleline">
        <property name="format" value="^\s+$"/>
        <property name="message" value="빈 줄에 공백이 있습니다."/>
    </module>

    <!-- 코드 안 연속 빈 줄 최대 2줄 -->
    <module name="RegexpMultiline">
        <property name="format" value="\n[ \t]*\n[ \t]*\n[ \t]*\n"/>
        <property name="message" value="연속 빈 줄은 최대 2줄입니다."/>
    </module>

    <!-- ImportOrder(separated=false)는 그룹 사이 빈 줄도 위반으로 보므로 해당 메시지만 제외 -->
    <module name="SuppressionSingleFilter">
        <property name="id" value="importOrderSorting"/>
        <property name="message" value="^Extra separation in import group"/>
    </module>

    <module name="TreeWalker">
        <!-- 들여쓰기 -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="8"/>
            <property name="arrayInitIndent" value="4"/>
            <property name="lineWrappingIndentation" value="8"/>
            <property name="forceStrictCondition" value="false"/>
        </module>

        <!-- import -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <!-- 그룹 순서·그룹 사이 빈 줄: 그 외 / javax·java / static -->
        <module name="CustomImportOrder">
            <property name="customImportOrderRules" value="THIRD_PARTY_PACKAGE###SPECIAL_IMPORTS###STATIC"/>
            <property name="specialImportsRegExp" value="^javax?\."/>
            <property name="separateLineBetweenGroups" value="true"/>
            <property name="sortImportsInGroupAlphabetically" value="false"/>
        </module>
        <!-- 그룹 안 정렬: javax 가 java 보다 먼저 (빈 줄 검사는 아래 필터로 끄고 CustomImportOrder 에 맡긴다) -->
        <module name="ImportOrder">
            <property name="id" value="importOrderSorting"/>
            <property name="groups" value="*,javax,java"/>
            <property name="ordered" value="true"/>
            <property name="separated" value="false"/>
            <property name="option" value="bottom"/>
            <property name="sortStaticImportsAlphabetically" value="true"/>
        </module>

        <!-- 중괄호 위치 -->
        <module name="LeftCurly">
            <property name="option" value="eol"/>
        </module>
        <module name="RightCurly">
            <property name="option" value="same"/>
            <property name="tokens"
                      value="LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_DO"/>
        </module>

        <!-- 어노테이션은 한 줄에 하나씩 (지역 변수·파라미터·enum 상수는 제외) -->
        <module name="AnnotationLocation">
            <property name="allowSamelineSingleParameterlessAnnotation" value="false"/>
            <property name="tokens"
                      value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, RECORD_DEF, ANNOTATION_DEF,
                             METHOD_DEF, CTOR_DEF, COMPACT_CTOR_DEF"/>
        </module>

        <!-- 공백 -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
            <property name="ignoreEnhancedForColon" value="false"/>
        </module>
        <module name="WhitespaceAfter"/>
        <module name="NoWhitespaceAfter">
            <property name="tokens"
                      value="AT, INC, DEC, UNARY_MINUS, UNARY_PLUS, BNOT, LNOT, DOT, METHOD_REF,
                             ARRAY_DECLARATOR, INDEX_OP"/>
        </module>
        <module name="NoWhitespaceBefore"/>
        <module name="NoWhitespaceBefore">
            <property name="tokens" value="DOT, METHOD_REF"/>
            <property name="allowLineBreaks" value="true"/>
        </module>
        <module name="MethodParamPad"/>
        <module name="ParenPad"/>
        <module name="GenericWhitespace"/>

        <!-- 빈 줄 -->
        <module name="EmptyLineSeparator">
            <property name="allowNoEmptyLineBetweenFields" value="false"/>
            <property name="allowMultipleEmptyLines" value="false"/>
            <property name="tokens"
                      value="PACKAGE_DEF, IMPORT, STATIC_IMPORT, CLASS_DEF, INTERFACE_DEF, ENUM_DEF,
                             RECORD_DEF, METHOD_DEF, CTOR_DEF, COMPACT_CTOR_DEF, VARIABLE_DEF"/>
        </module>

        <!-- 줄바꿈 위치 -->
        <module name="OperatorWrap">
            <property name="option" value="nl"/>
            <property name="tokens" value="QUESTION, COLON"/>
        </module>
        <module name="OperatorWrap">
            <property name="option" value="eol"/>
            <property name="tokens"
                      value="PLUS, MINUS, STAR, DIV, MOD, EQUAL, NOT_EQUAL, GT, GE, LT, LE, LAND, LOR,
                             BAND, BOR, BXOR, SL, SR, BSR, LITERAL_INSTANCEOF"/>
        </module>
        <module name="OperatorWrap">
            <property name="option" value="eol"/>
            <property name="tokens"
                      value="ASSIGN, PLUS_ASSIGN, MINUS_ASSIGN, STAR_ASSIGN, DIV_ASSIGN, MOD_ASSIGN,
                             SR_ASSIGN, BSR_ASSIGN, SL_ASSIGN, BAND_ASSIGN, BXOR_ASSIGN, BOR_ASSIGN"/>
        </module>
        <module name="SeparatorWrap">
            <property name="option" value="nl"/>
            <property name="tokens" value="DOT"/>
        </module>

        <!-- 한 줄에 문장 하나 -->
        <module name="OneStatementPerLine"/>
    </module>
</module>
